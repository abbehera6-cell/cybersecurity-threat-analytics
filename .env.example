# Copy this file to .env and fill in your local values.
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored and must never be committed.

# --- PostgreSQL ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_threat
DB_USER=postgres
DB_PASSWORD=change_me

# --- Pipeline --------------------------------------------------------------
# Rows per read/insert batch. 200000 keeps peak memory under ~1.5 GB for the
# 2.83M-row CICIDS2017 release on a 8 GB machine. Lower it if PostgreSQL
# reports memory pressure during COPY.
PIPELINE_BATCH_SIZE=200000

# INFO or DEBUG. DEBUG prints per-file progress and every validation failure.
LOG_LEVEL=INFO
